# ─── Anthropic (the chat LLM) ───────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── Naive ──────────────────────────────────────────────────────────────────
# A workspace API key from the Naive dashboard (Settings -> API Keys).
NAIVE_API_KEY=nv_sk_live_...
# The Naive API base. Use staging while testing, or https://api.usenaive.ai.
NAIVE_API_URL=https://api.usenaive.ai
# The Account Kit new users are assigned to (create one in the dashboard).
# Leave blank to use your workspace's default kit.
NAIVE_ACCOUNT_KIT_ID=

# ─── BetterAuth ─────────────────────────────────────────────────────────────
# Any long random string. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3400

# ─── Database (libSQL / SQLite — zero setup) ────────────────────────────────
# Local file by default. Swap for a Turso/libSQL URL + token for hosted.
DATABASE_URL=file:./dev.db
# DATABASE_AUTH_TOKEN=
